{
    "name": "koh/typo3-async",
    "description": "Asynchronous TYPO3 work over Symfony Messenger: mails leave the request, with retries and a failure queue, switched on per environment.",
    "license": "MIT",
    "type": "typo3-cms-extension",
    "keywords": [
        "typo3",
        "messenger",
        "queue",
        "mail",
        "async",
        "kubernetes"
    ],
    "authors": [
        {
            "name": "Kai Ole Hartwig",
            "email": "support@ole-hartwig.eu",
            "role": "Maintainer"
        },
        {
            "name": "Kai Ole Hartwig",
            "email": "o.hartwig@ole-hartwig.eu",
            "role": "Developer"
        }
    ],
    "homepage": "https://ole-hartwig.eu/open-source",
    "require": {
        "php": "^8.5.11",
        "psr/container": "^2.0.2",
        "psr/log": "^3.0.2",
        "symfony/doctrine-messenger": "^7.4.20",
        "symfony/mailer": "^7.4.19",
        "symfony/messenger": "^7.4.20",
        "symfony/mime": "^7.4.19",
        "typo3/cms-core": "^14.3"
    },
    "require-dev": {
        "deptrac/deptrac": "^4.7.2",
        "ergebnis/composer-normalize": "^2.54.0",
        "koh/dev-typo3": "^1.0",
        "phpstan/phpstan-deprecation-rules": "^2.0.5",
        "phpunit/phpunit": "^13.3.6",
        "typo3/testing-framework": "^9.7.0",
        "symfony/dependency-injection": "^7.4.20"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://git.ole-hartwig.eu/api/v4/group/1091/-/packages/composer/",
            "only": [
                "koh/dev*"
            ]
        }
    ],
    "autoload": {
        "psr-4": {
            "Koh\\Typo3Async\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Koh\\Typo3Async\\Tests\\": "Tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true,
            "ergebnis/composer-normalize": true,
            "phpstan/extension-installer": true,
            "sbuerk/typo3-cmscomposerinstallers-testingframework-bridge": true,
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        },
        "sort-packages": true
    },
    "extra": {
        "typo3/cms": {
            "Package": {
                "providesPackages": {}
            },
            "extension-key": "koh_async"
        }
    },
    "scripts": {
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "deptrac": "deptrac analyse --no-progress",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "qa": [
            "@cs:check",
            "@phpstan",
            "@deptrac",
            "@test"
        ],
        "test": "phpunit --testsuite=Unit"
    }
}
